# MySQL
MYSQL_DATABASE=travel_db
MYSQL_USER=travel_user
MYSQL_PASSWORD=replace-with-a-secure-password
MYSQL_ROOT_PASSWORD=replace-with-a-secure-root-password

# Spring datasource inside the Docker Compose network
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/travel_db
SPRING_DATASOURCE_USERNAME=travel_user
SPRING_DATASOURCE_PASSWORD=replace-with-the-same-secure-password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# Use a cryptographically random value of at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
